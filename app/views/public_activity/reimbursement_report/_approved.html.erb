<%# locals: (activity:, p:, current_user: nil, **) %>

<% current_user ||= p[:current_user] %>

<% if activity.trackable.present? %>
  <%= render layout: "/public_activity/common", locals: { activity:, current_user:, url: reimbursement_report_path(activity.trackable), possessive: true } do %>
    report <i><%= link_to activity.trackable.name, activity.trackable %></i>
    <% if activity.trackable.event %>
      on <%= link_to activity.trackable.event.name, activity.trackable.event %>
    <% end %>
    was approved
  <% end %>
<% end %>
